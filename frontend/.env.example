# URL publique du backend Go SYGREN (déployé sur Render, Railway, etc.)
# En dev (sandbox), laisser vide : le frontend utilise les chemins relatifs
# avec ?XTransformPort=8080 via le gateway Caddy.
# En prod (Vercel), définir avec l'URL du backend déployé, ex:
# NEXT_PUBLIC_API_URL=https://sygren-api.onrender.com
NEXT_PUBLIC_API_URL=

# Secret JWT (côté backend uniquement, pas exposé au frontend)
# JWT_SECRET=your-jwt-secret

# URL de connexion base de données PostgreSQL (Neon)
# DATABASE_URL=postgresql://...
